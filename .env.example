# Copy to .env and fill in. Every variable here is validated: the `NEXT_PUBLIC_*` ones by
# src/infra/env.client.ts, at build time — they are inlined into the browser bundle — the rest by
# src/infra/env.server.ts.

# The SQLite database file, relative to the repo root; `pnpm prisma migrate deploy` creates it.
DATABASE_URL="file:./data/sudoku.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

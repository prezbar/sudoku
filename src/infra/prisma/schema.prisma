// The connection URL lives in prisma.config.ts, which reads it from the environment.

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../../../generated/prisma"
}

model Game {
  // Prisma 7 dropped cuid v1; `cuid(2)` is the supported spelling.
  id                String    @id @default(cuid(2))
  // The givens, as 81 digits in row-major order, 0 for an empty cell.
  puzzle            String
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  durationInSeconds Int?
  playerName        String?

  @@index([durationInSeconds])
}

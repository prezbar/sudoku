// The connection URL lives in prisma.config.ts, which reads it from the environment.

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../../../generated/prisma"
}

model User {
  // Prisma 7 dropped cuid v1; `cuid(2)` is the supported spelling.
  id    String @id @default(cuid(2))
  email String @unique
}

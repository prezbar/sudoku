datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../../../generated/prisma"
}

model Game {
  id                String    @id @default(cuid(2))
  puzzle            String
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  durationInSeconds Int?
  playerName        String?

  @@index([durationInSeconds])
}

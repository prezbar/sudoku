{
  "name": "sudoku",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": "^22.22 || ^24 || >=26"
  },
  "scripts": {
    "dev": "next dev",
    "check": "tsx scripts/gate.ts format:check+lint+duplication+typecheck,test:changed",
    "gate": "tsx scripts/gate.ts format:check+lint+duplication+typecheck,test+build",
    "build": "next build",
    "prestart": "tsx --conditions=react-server scripts/prestart.ts",
    "start": "next start",
    "next-pipe:gen": "next-pipe gen --out-dir generated/routes",
    "postinstall": "prisma generate && pnpm next-pipe:gen && next typegen",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content --max-warnings=0 .",
    "duplication": "jscpd",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed ${CHECK_BASE:-origin/main}",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@flefebvre/next-pipe": "^2.0.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.6",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@faker-js/faker": "^10.6.0",
    "@flefebvre/prisma-factorio": "^1.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-no-comments": "^1.2.1",
    "jscpd": "^5.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
